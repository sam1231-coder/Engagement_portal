# ==============================================================================
# HUMANLY — Git Ignore Rules
# ==============================================================================

# Database & Runtime Storage
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
humanly.db

# Dependencies
node_modules/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Environment Variables & Secrets
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS Artifacts
.DS_Store
Thumbs.db
ehthumbs.db

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.qodo/

# Testing & Scratch Artifacts
scratch/
coverage/
