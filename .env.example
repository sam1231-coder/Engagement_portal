# ==============================================================================
# HUMANLY — Environment Configuration Template
# Copy this file to .env and adjust variables for your target deployment
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Database Configuration
# Default: Embedded SQLite database located at ./humanly.db (Zero-setup required)
# For PostgreSQL deployments, uncomment and configure:
# DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/humanly?sslmode=disable

# Security & Session Tokens
SESSION_TTL_HOURS=48
JWT_SECRET=replace_with_a_long_random_entropy_key_for_production_2026

# Meeting & External Integrations (Optional Webhooks)
GOOGLE_MEET_INTEGRATION=enabled
MICROSOFT_TEAMS_INTEGRATION=enabled
ZOOM_API_INTEGRATION=enabled
